# Public build-time value from a Cloudflare Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Enable only after DocsGPT Agent API access and runtime secrets are verified.
NEXT_PUBLIC_CHAT_ENABLED=false

# TinaCloud Free project credentials (Cloudflare Pages build-time values).
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Optional local/preview override. Cloudflare Pages otherwise supplies CF_PAGES_BRANCH.
NEXT_PUBLIC_TINA_BRANCH=main

# Runtime Cloudflare Pages Function secrets/variables.
TURNSTILE_SECRET_KEY=
# DocsGPT Cloud published Agent key (never prefix with NEXT_PUBLIC_).
DOCSGPT_API_KEY=
# Independent random secret, at least 32 characters, for signed conversation cookies.
CHAT_SESSION_SECRET=
SMS_API_KEY=
SMS_ADMIN_MOBILE=09xxxxxxxxx
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zoho CRM OAuth (server-only; use the Accounts URL for your Zoho data center).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=
